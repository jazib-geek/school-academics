# Copy to `.env` for local dev. Production uses `.env.production` (see README or deploy docs).
# API origin — no trailing slash (e.g. https://sciencebaseschool.com or https://localhost:7093).
VITE_API_BASE_URL=https://localhost:7093
VITE_LOGIN_PATH=/api/auth/campus-login
VITE_CAMPUS_HEADER=X-Campus
# Optional: limit campus dropdown (e.g. demo-only). Leave unset for all campuses.
# VITE_CAMPUS_ALLOWLIST=demo
