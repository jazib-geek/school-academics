                    .slip-page {
                        page-break-after: always;
                        display: flex;
                        flex-wrap: wrap;
                    }

                    .salary-slip {
                        page-break-inside: avoid;
                        break-inside: avoid;
                    }


                }



            </style>
        </head>
        <body>
            ${slipsHtml}
        </body>
        </html>
    `);

        printWindow.document.close();
        printWindow.focus();
        //printWindow.print();
        //printWindow.close();

