    // Print
    function printTable() {
        var tableHtml = document.getElementById("table").outerHTML;

        var printWindow = window.open('', '', 'width=800,height=600');
        printWindow.document.write(`
        <html>
            <head>
                <title>Print Table</title>
            </head>
            <body>
                ${tableHtml}
            </body>
            <style>

     @@media print {
          @@page {
            size: landscape;
        }
         body {
             margin: 0;
         }

        body {
            font-family: Arial !important;
            font-size: 11px !important;
            margin: 5px !important;
            color: #000 !important;
        }

        table {
            border-collapse: collapse !important;
            width: 100% !important;
        }

        th, td {
            border: 1px solid #000 !important;
            padding: 3px !important;
            text-align: left !important;
        }

        th {
            background-color: #eee !important;
            font-weight: bold !important;
        }

        .d-none {
    display: none !important;
}
     }
</style>
        </html>
        `);
        printWindow.document.close();
        printWindow.focus();
        printWindow.print();
        printWindow.close();
    }
    function printSalarySlips() {
        const rows = document.querySelectorAll("#table tbody tr");
        let slipsHtml = '';
        let slipCount = 0;

        rows.forEach((row, index) => {
            const cells = row.querySelectorAll("td");
            const data = {
                account: cells[0]?.innerText.trim(),
                name: cells[1]?.innerText.trim(),
                basicPay: cells[2]?.innerText.trim(),
                absences: cells[6]?.innerText.trim(),
                absDeduction: cells[6]?.innerText.trim(),
                lateComings: cells[4]?.innerText.trim(),
                lateDeduction: cells[5]?.innerText.trim(),
                advance: cells[13]?.innerText.trim(),
                specialDeduction: cells[14]?.innerText.trim(),
                totalSalary: cells[9]?.innerText.trim(),
                bonus: cells[9]?.innerText.trim(),
                netTotal: cells[11]?.innerText.trim(),

                absences: cells[12]?.innerText.trim()
            };

            if (slipCount % 4 === 0) {
                if (slipCount > 0) slipsHtml += `</div>`; // Close previous page
                slipsHtml += `<div class="slip-page" style="display: flex; flex-wrap: wrap; page-break-after: always;">`; // New page
            }

            slipsHtml += `
            <div class="salary-slip" style="width: 48%; border: 1px solid #000; margin: 1%; padding: 5px; border-radius: 6px; font-size: 11px; box-sizing: border-box; page-break-inside: avoid;">
                <div class="slip-header" style="text-align: center; font-weight: bold; font-size: 13px; margin-bottom: 8px;">Salary for ${$("#month option:selected").text()} ${$("#year option:selected").text() }</div>
                <table style="width: 100%; border-collapse: collapse;">
                    <tbody>
                        <tr><td style="border: 1px solid #000; padding: 3px 5px;">Account No:</td><td style="border: 1px solid #000; padding: 3px 5px;">${data.account}</td></tr>
                        <tr><td style="border: 1px solid #000; padding: 3px 5px;">Name:</td><td style="border: 1px solid #000; padding: 3px 5px;">${data.name}</td></tr>
                        <tr><td style="border: 1px solid #000; padding: 3px 5px;">Basic Pay:</td><td style="border: 1px solid #000; padding: 3px 5px;">${data.basicPay}</td></tr>
                        <tr><td style="border: 1px solid #000; padding: 3px 5px;">Absences:</td><td style="border: 1px solid #000; padding: 3px 5px;">${data.absences}</td></tr>
                        <tr><td style="border: 1px solid #000; padding: 3px 5px;">Absence Deduction:</td><td style="border: 1px solid #000; padding: 3px 5px;">${data.absDeduction}</td></tr>
                        <tr><td style="border: 1px solid #000; padding: 3px 5px;">Late Comings:</td><td style="border: 1px solid #000; padding: 3px 5px;">${data.lateComings}</td></tr>
                        <tr><td style="border: 1px solid #000; padding: 3px 5px;">Late Deduction:</td><td style="border: 1px solid #000; padding: 3px 5px;">${data.lateDeduction}</td></tr>
                        <tr><td style="border: 1px solid #000; padding: 3px 5px;">Advance:</td><td style="border: 1px solid #000; padding: 3px 5px;">${data.advance}</td></tr>
                        <tr><td style="border: 1px solid #000; padding: 3px 5px;">Special Deduction:</td><td style="border: 1px solid #000; padding: 3px 5px;">${data.specialDeduction}</td></tr>
                       <tr><td style="border: 1px solid #000; padding: 3px 5px;">Bonus:</td><td style="border: 1px solid #000; padding: 3px 5px;">${data.bonus}</td></tr>
                        <tr><td style="border: 1px solid #000; padding: 3px 5px;"><strong>Net Total:</strong></td><td style="border: 1px solid #000; padding: 3px 5px;">${data.netTotal}</td></tr>
                   <tr> 
<td colspan="2" class="urdu-note" style="font-family: 'Alvi Nastaleeq', serif; direction: rtl; text-align: center;">  
برائے مہربانی اپنے پیسے آفس میں ہی پورے کر لیں بعد میں ذمہ داری نہیں ہوگی۔
</td>
</tr>
                        </tbody>
                </table>
             <div>

</div>
            </div>
        `;

            slipCount++;
        });

        slipsHtml += `</div>`; // Close last slip-page

        const printWindow = window.open('', '', 'width=800,height=600');
        printWindow.document.write(`
        <html>
        <head>
            <title>Salary Slips</title>
            <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
            <style>
                body {
                    background: #fff;
                    padding: 0.3cm;
                    font-size: 12px;
                    font-family: Arial, sans-serif;
                    margin: 0;
                }

                @@font-face {
  font-family: 'Alvi Nastaleeq';
        src: url('../../../../fonts/Alvi Nastaleeq.ttf');
}

.urdu-note {
  font-family: 'Alvi Nastaleeq', 'Noto Nastaliq Urdu', serif;
  font-size: 13px;
  direction: rtl;
  text-align: right;
  margin-top: 10px;
}



