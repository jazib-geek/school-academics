@*darkslateblue*@
@using Data.BLL

<div class="main">
    <div class="card">
        <h4 class="card-header text-center">
            <i class="la la-money-bill"></i> CALCULATE SALARY

        </h4>
    </div>
    <div class="card">
        <div class="row py-2">
            <div class="col-md-2"></div>
            <div class="col-md-2">
                <select id="month" class="form-control">
                    <option value="">------Month------</option>
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i">@DateFunctions.convertToStringMonth(i)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select id="year" class="form-control">
                    <option value="@(DateTime.Now.Year - 1)">@(DateTime.Now.Year - 1)</option>
                    <option value="@DateTime.Now.Year" selected="selected">@DateTime.Now.Year</option>
                </select>
            </div>

            <div class="col-md-4">
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-primary" id="generateSalary"><i class="la la-calculator"></i> Calculate</button>
                    <button type="button" class="btn btn-soft-secondary border-secondary" onclick="printTable()"> <i class="la la-print"></i> Print Report</button>
                    <button type="button" class="btn btn-soft-success border-success" onclick="printSalarySlips()"> <i class="la la-print"></i> Print Slips</button>
                </div>
            </div>
            @Html.Partial("_spinner")

        </div>
        <table id="table" class="table table-bordered">
            <thead class="bg-soft-info">
                <tr>
                    <th style="text-align:center;width:5%">ID</th>
                    <th style="text-align:center;width:20%">Name</th>
                    <th style="text-align:center;width:10%">Basic Salary</th>
                    <th style="text-align:center;width:10%">Days Present</th>
                    <th style="text-align:center;width:5%">LC</th>
                    <th style="text-align:center;width:10%">Late Deduction</th>
                    <th style="text-align:center;width:10%">Absent Deduction</th>
                    <th style="text-align:center;width:10%">Working Days Salary</th>
                    <th style="text-align:center;width:10%">Loan/SC</th>
                    <th style="text-align:center;width:10%">Bonus</th>
                    <th style="text-align:center;width:15%">Net Salary</th>
                </tr>
            </thead>
            <tbody id="salaryListContainer"></tbody>
            <tfoot>
                <tr class="text-center fs-14">
                    <td colspan="9"></td>
                    <td id="NET" class="bg-soft-info fw-bold">-</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>


@*<script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
<script src="/signalr/hubs"></script>*@

<script>
    let generationId = crypto.randomUUID(); 

    $(function () {
        let pollInterval;
        $("#generateSalary").click(function () {
            if ($("#month").val() == '') {
                alert_warning('Please select Month/Year');
                return;
            }

            showSalaryProgressModal();
            $("#status").text("Generating salaries...");

            // Start generation
            $.post('/Employee/Salary/StartGeneration', {
                month: $("#month").val(),
                year: $("#year").val(),
                generationId: generationId
            }, function () {
                // Start polling
                pollInterval = setInterval(pollProgress, 500);
            });
        });

        function pollProgress() {
            $.get('/Employee/Salary/GetSalaryProgress', { generationId: generationId }, function (percentage) {
                $("#progressBar").css("width", percentage + "%").text(percentage + "%");

                if (percentage >= 100) {
                    clearInterval(pollInterval);
                    $("#status").text("Completed");
                    swal.close();
                    setTimeout(function () {
                        loadSalaryList(generationId);
                    }, 500);
                }
            });
        }

        function loadSalaryList(generationId) {
            $("#salaryListContainer").load('/Employee/Salary/GetGeneratedSalaryList', {
                month: $("#month").val(),
                year: $("#year").val(),
                generationId: generationId,
            });
        }

        function showSalaryProgressModal() {
            Swal.fire({
                title: "Generating Salaries...",
                html: `
            <div class="progress mt-3">
                <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated"
                     role="progressbar" style="width: 0%;">0%</div>
            </div>
        `,
                allowOutsideClick: false,
                showCancelButton: false,
                showConfirmButton: false
            });
        }
    });

</script>

