        }
    }

    ///////////////////////////////////////////////////////////////////////
    //////////////////////////// TEMP LISTS ///////////////////////////////
    function RefreshQual()
    {
        $.ajax({
            cache: false,
            type: 'Get',
            url: '/Employee/New/_TempQual',
            data: { Hash: '@Model.Hash', Type: 'Qual' },
            datatype: 'Json',
            success: function (result) {
                $("#tblQual").css('opacity', '1');
                $("#tblQual").html(result);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                $("body").html(xhr.responseText);
            }
        });
    }

    function RefreshExp() {
        $.ajax({
            cache: false,
            type: 'Get',
            url: '/Employee/New/_TempExp',
            data: { Hash: '@Model.Hash', Type: 'Exp' },
            datatype: 'Json',
            success: function (result) {
                $("#tblExp").css('opacity', '1');
                $("#tblExp").html(result);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                $("body").html(xhr.responseText);
            }
        });
    }


    function RefreshSubjects() {
        $.ajax({
            cache: false,
            type: 'Get',
            url: '/Employee/New/_TempSubject',
            data: { Hash: '@Model.Hash', Type: 'Subject' },
            datatype: 'Json',
            success: function (result) {
                $("#tblSubject").css('opacity', '1');
                $("#tblSubject").html(result);

            },
            error: function (xhr, ajaxOptions, thrownError) {
                $("body").html(xhr.responseText);
            }
        });
    }

    function RefreshAssets() {
        $.ajax({
            cache: false,
            type: 'Get',
            url: '/Employee/New/_TempAsset',
            data: { Hash: '@Model.Hash', Type: 'Asset' },
            datatype: 'Json',
            success: function (result) {
                $("#tblAsset").css('opacity', '1');
                $("#tblAsset").html(result);

            },
            error: function (xhr, ajaxOptions, thrownError) {
                $("body").html(xhr.responseText);
            }
        });
    }
    ///////////////////////////////////////////////////////
    ///////////////////////////////////////////////////////
    function DeleteRow(id) {
        $.ajax({
            cache: false,
            type: 'POST',
            url: '/Employee/New/DeleteTempRow',
            data: { ID : id },
            datatype: 'Json',
            success: function (result) {
                RefreshQual();
                RefreshSubjects();
                RefreshExp();
                RefreshAssets();
            },
            error: function (xhr, ajaxOptions, thrownError) {
                $("body").html(xhr.responseText);
            }
        });
    }

    //// DATE PICKERS START /////
    $(function () {
        $(".datepicker").datepicker({
            autoclose: true,
            todayHighlight: true
        }).datepicker();
    });

</script>

