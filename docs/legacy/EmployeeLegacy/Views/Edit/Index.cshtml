@using Data.BLL.Employee
@using Data.DAL
@model Data.DAL.v_Employee

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.3.0/js/bootstrap-datepicker.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.3.0/css/datepicker.css" rel="stylesheet" type="text/css" />

@{
    dbSchoolEntities db = new dbSchoolEntities();
}

<div class="card" style="line-height: inherit !important; margin-bottom: 80px; border: 5px solid #176da5;">
    <h4 class="card-header text-center text-primary">
        <i class="la la-user"></i> @Model.EmployeeName
    </h4>
    @using (Html.BeginForm("New", "Teacher", FormMethod.Post, new { id = "CreateStudentForm" }))
    {

        <ul class="nav nav-pills nav-justified" role="tablist" style="width: 60%; border: 1px solid rgb(50, 63, 108); border-radius: 0.5em;;">
            <li class="nav-item waves-effect waves-light">
                <a class="nav-link active pillborder" data-bs-toggle="tab" id="tab_std" href="#basic" role="tab">
                    <i class="fa fa-user"></i> Basic Info
                </a>
            </li>
            <li class="nav-item waves-effect waves-light">
                <a class="nav-link pillborder" data-bs-toggle="tab" href="#acad" role="tab">
                    <i class="fa fa-trophy"></i> Academic Info
                </a>
            </li>
            <li class="nav-item waves-effect waves-light">
                <a class="nav-link pillborder" data-bs-toggle="tab" href="#exp" role="tab">
                    <i class="fa fa-pencil"></i> Experience
                </a>
            </li>
            <li class="nav-item waves-effect waves-light">
                <a class="nav-link pillborder" data-bs-toggle="tab" href="#loan" role="tab">
                    <i class="fa fa-money"></i> Loan and Security
                </a>
            </li>
        </ul>

        <div class="tab-content">
            <div role="tabpanel" class="tab-pane active" id="basic">
                <div class="inner-container">
                    @*<div class="heading-bar" style="background:#176da5; color:white">
                            EDIT : @Model.EmployeeName
                        </div>*@

                    <div class="inner-col">
                        <div class="left">
                            <div class="inner-left">
                                Employee Name* &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.TextBoxFor(m => m.EmployeeName, "", new { @class = "input-borderless" })
                            </div>
                        </div>
                        <div class="right">
                            <div class="inner-left">
                                Father Name* &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.TextBoxFor(m => m.FatherName, "", new { @class = "input-borderless" })
                            </div>
                        </div>
                    </div>

                    <div class="inner-col">
                        <div class="left">
                            <div class="inner-left">
                                Date of Birth* &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right" style="padding-top: 7px !important;">
                                @Html.TextBoxFor(m => m.DoB, "", new { @class = "input-borderless datepicker" })
                            </div>

                        </div>
                        <div class="right">
                            <div class="inner-left">
                                Gender &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right" style="padding-top: 7px !important;">
                                <input id="Male" type="radio" name="Gender" value="Male" checked="checked" style="margin: -8px 0 0 !important" @(Model.Gender == "Male" ? "checked" : "") />
                                <label for="Male">Male</label>
                                &nbsp; &nbsp; &nbsp;
                                <input id="Female" type="radio" name="Gender" value="Female" style="margin: -8px 0 0 !important" @(Model.Gender == "Female" ? "checked" : "") />&nbsp;
                                <label for="Female">Female</label>
                            </div>
                        </div>
                    </div>

                    <div class="inner-col">
                        <div class="left" style="float:right">
                            <div class="inner-left">
                                Religion &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right" style="padding-top: 7px !important;">
                                <input id="Muslim" type="radio" name="Religion" value="Muslim" checked="checked" style="margin: -8px 0 0 !important" @(Model.Religion == "Muslim" ? "checked" : "") ) />
                                <label for="Muslim">Muslim</label>
                                &nbsp; &nbsp; &nbsp;
                                <input id="Non-Muslim" type="radio" name="Religion" value="Non-Muslim" style="margin: -8px 0 0 !important" @(Model.Religion == "Non-Muslim" ? "checked" : "") />&nbsp;
                                <label for="Non-Muslim">Non-Muslim</label>
                            </div>
                        </div>
                        <div class="right">
                            <div class="inner-left">
                                Marital Status &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                <select id="MaritalStatus" class="input-borderless">
                                    <option value="N/A">N/A</option>
                                    <option value="Unmarried">Unmarried</option>
                                    <option value="Married">Married</option>
                                    <option value="Divorced">Divorced</option>
                                    <option value="Widowed">Widowed</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="inner-col">
                        <div class="left">
                            <div class="inner-left">
                                Blood Group &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                <select id="Blood_Group" class="input-borderless">
                                    <option value="N/A">N/A</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                </select>
                            </div>
                        </div>
                        <div class="right hide">
                            <div class="inner-left">
                                Locality &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.DropDownListFor(m => m.LocalityID, new SelectList(Data.BLL.LocalityFunctions.lstLocality(), "ID", "LocalityName"), new { @class = "input-borderless", @id = "loc" })
                            </div>
                        </div>
                    </div>

                    <div class="inner-col">
                        <div class="full">
                            <div class="left-15">
                                Address* &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="right-85">
                                @Html.TextBoxFor(m => m.Permanent_Address, "", new { @class = "input-borderless" })
                            </div>
                        </div>
                    </div>

                    <div class="inner-col">
                        <div class="left">
                            <div class="inner-left">
                                Home Phone &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.TextBoxFor(m => m.HomePhone, "", new { @class = "input-borderless" })
                            </div>
                        </div>
                        <div class="right">
                            <div class="inner-left">
                                CNIC &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.TextBoxFor(m => m.CNIC, "", new { @class = "input-borderless" })
                            </div>
                        </div>
                    </div>

                    <div class="inner-col">
                        <div class="left">
                            <div class="inner-left">
                                Mobile 1* &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.TextBoxFor(m => m.Contact1, "", new { @class = "input-borderless" })
                            </div>
                        </div>
                        <div class="right">
                            <div class="inner-left">
                                Mobile 2 &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.TextBoxFor(m => m.Contact2, "", new { @class = "input-borderless" })
                            </div>
                        </div>
                    </div>

                    <div class="inner-col">
                        <div class="left">
                            <div class="inner-left">
                                Mobile 3 &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.TextBoxFor(m => m.Contact3, "", new { @class = "input-borderless" })
                            </div>
                        </div>
                        <div class="right">
                            <div class="inner-left">
                                Email &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.TextBoxFor(m => m.Email, "", new { @class = "input-borderless" })
                            </div>
                        </div>
                    </div>

                    <div class="inner-col">
                        <div class="left">
                            <div class="inner-left">
                                Identity Mark &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.TextBoxFor(m => m.IdentityMark, "", new { @class = "input-borderless" })
                            </div>
                        </div>
                        <div class="right">
                            <div class="inner-left">
                                Referred by &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.TextBoxFor(m => m.Refered_By, "", new { @class = "input-borderless" })
                            </div>
                        </div>
                    </div>

                    @*UPPER SECTION END*@



                    @*SUBJECT START*@

                    <div class="heading-bar">
                        Subject(s) Can Teach
                    </div>

                    <div class="padded">
                        <div class="inner-col">
                            <div class="left">
                                <div class="inner-left">
                                    Subject &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                                </div>
                                <div class="inner-right">
                                    <select id="SubjectID" class="input-borderless" onchange="InsertSubject()">
                                        <option value="">---select subject---</option>
                                        @foreach (var item in Data.BLL.Parameter.Subject.List())
                                        {
                                            <option value="@item.ID">@item.SubjectName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="right">
                                <div class="inner-left">
                                    &nbsp; <i class="la la-caret-down gray"></i> &nbsp;
                                </div>
                                <div class="inner-right">
                                </div>
                            </div>
                        </div>

                        <div class="inner-col">
                            <div class="full">
                                <div class="right-85">
                                    <div style="width:117%; float:right" class="white-row" id="tblSubject">
                                        <i class="la la-spin la-spinner"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @*SUBJECT END*@







                    @*ASSET START*@
                    @*<div class="heading-bar">
                            ASSIGNED ASSETS
                        </div>*@

                    <div class="padded">
                        <div id="tblAsset"></div>
                    </div>
                    @*ASSET END*@



                    @*OFFICE USE SECTION START*@

                    <div class="heading-bar">
                        FOR OFFICE USE
                    </div>

                    <div class="inner-col">
                        <div class="left">
                            <div class="inner-left">
                                Joining Date* &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.TextBoxFor(m => m.Joining_Date, "", new { @class = "input-borderless datepicker" })
                            </div>
                        </div>
                        <div class="right">
                            <div class="inner-left">
                                Salary* &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.TextBoxFor(m => m.MonthlySalary, "", new { @class = "input-borderless" })
                            </div>
                        </div>
                    </div>

                    <div class="inner-col">
                        <div class="left">
                            <div class="inner-left">
                                Designation &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.DropDownListFor(m => m.DesignationID, new SelectList(Data.BLL.Employee.List.lstDesignation(), "ID", "Designation"), new { @class = "input-borderless" })
                            </div>
                        </div>
                        <div class="right">
                            <div class="inner-left">
                                Level &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                <input id="Trained" type="radio" name="IsTrained" value="1" checked="checked" style="margin: -8px 0 0 !important" />
                                <label for="Trained">Trained</label>
                                &nbsp; &nbsp; &nbsp;
                                <input id="UnTrained" type="radio" name="IsTrained" value="0" style="margin: -8px 0 0 !important" />&nbsp;
                                <label for="UnTrained">UnTrained</label>
                            </div>
                        </div>
                    </div>

                    <div class="inner-col">
                        <div class="left">
                            <div class="inner-left">
                                Thumb ID &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.TextBoxFor(m => m.Thumb_ID, "", new { @class = "input-borderless" })
                            </div>
                        </div>
                        <div class="right">
                            <div class="inner-left">
                                Approved By &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                            </div>
                            <div class="inner-right">
                                @Html.TextBoxFor(m => m.ApprovedBy, "", new { @class = "input-borderless" })
                            </div>
                        </div>
                    </div>

                    <div class="inner-col">
                        <div class="text-center top-10">
                            <input type="button" id="btnSubmit" class="btn btn-primary" value="Update" onclick="SubmitByAjax()" />

                        </div>
                    </div>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane" id="acad">


                <div class="heading-bar">
                    Academic Information
                </div>

                <div class="padded">
                    <div id="tblQual"></div>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane" id="exp">
                <div class="heading-bar">
                    EXPERIENCE
                </div>

                <div class="padded">
                    <div id="tblExp"></div>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane" id="loan">
                <div class="heading-bar">
                    Security Charges And Loan History
                </div>

                <div class="padded">
                    <div id="tblComponent">
                        <i class="la la-spin la-spinner"></i>
                    </div>
                </div>
            </div>
        </div>

    }
</div>

<script>
    $(document).ready(function () {
        $("#MaritalStatus").val('@Model.MaritalStatus')
        $("#Blood_Group").val('@Model.Blood_Group')

        RefreshQual();
        RefreshExp();
        RefreshComponent();
       // RefreshAssets();
        RefreshSubjects();

    });

    // SUBMIT

    function SubmitByAjax() {

        if ($("#EmployeeName").val() == '' || $("#MonthlySalary").val() == '') {
            alert_error("Required","Fill all required fileds");
        }
        else {
            $("#btnSubmit").attr('disabled', true);

            var data = new FormData();

            data.append("ID", '@Model.ID');
            data.append("DesignationID", $("#DesignationID").val());
            data.append("EmployeeName", $("#EmployeeName").val());
            data.append("FatherName", $("#FatherName").val());
            data.append("DoB", $("#DoB").val());
            data.append("MaritalStatus", $("#MaritalStatus").val());
            data.append("Email", $("#Email").val());
            data.append("Gender", $('input[name=Gender]:checked').val());
            data.append("ProfessionalDegree", $('input[name=ProfessionalDegree]:checked').val());
            data.append("IdentityMark", $("#IdentityMark").val());
            data.append("Religion", $('input[name=Religion]:checked').val());
            data.append("Blood_Group", $("#Blood_Group").val());
            data.append("Joining_Date", $("#Joining_Date").val());
            data.append("LocalityID", $("#loc").val());
            data.append("CNIC", $("#CNIC").val());
            data.append("HomePhone", $("#HomePhone").val());
            data.append("Permanent_Address", $("#Permanent_Address").val());
            data.append("Contact1", $("#Contact1").val());
            data.append("Contact2", $("#Contact2").val());
            data.append("Contact3", $("#Contact3").val());
            data.append("IsTrained", $("#IsTrained").val());
            data.append("Salary", $("#MonthlySalary").val());
            data.append("Refered_By", $("#Refered_By").val());
            data.append("HomePhone", $("#HomePhone").val());
            data.append("Thumb_ID", $("#Thumb_ID").val());
            data.append("ApprovedBy", $("#ApprovedBy").val());
           // data.append("VerifiedBy", $("#VerifiedBy").val());

            $.ajax({
                cache: false,
                type: 'POST',
                processData: false,
                contentType: false,
                url: '/Employee/Edit/Update',
                data: data,
                success: function (result) {
                    // alert_success('Success','Employee entry Updated');
                    if (result.msg == 'success') {
                        window.location.href = '/Employee/List/';
                    }
                    else {
                        alert_error('Error', result.desc);
                        return;
                    }
               },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("body").html(xhr.responseText);
                }
            });
        }
    }

    function ResetForm() {
        $("#DesignationID").val(1);
        $("#TeacherName").val('');
        $("#FatherName").val('');
        $("#DoB").val('');
        $("#Email").val('');
        $("#IdentityMark").val('');
        $("#Blood_Group").val('');
        $("#Joining_Date").val('');
        $("#Permanent_Address").val('');
        $("#CNIC").val('');
        $("#HomePhone").val('');
        $("#Contact1").val('');
        $("#Contact2").val('');
        $("#Contact3").val('');
        $("#IsTrained").val('');
        $("#Salary").val('');
        $("#Refered_By").val('');
        $("#HomePhone").val('');
        $("#ApprovedBy").val('');
        $("#VerifiedBy").val('');

        RefreshAssets();
        RefreshExp();
        RefreshQual();
        RefreshSubjects();

    }



    //////////////// TEMP INSERTIONS //////////////
    function InsertComponent() {
        if ($("#ComponentMonth").val() == '' || $("#ComponentYear").val() == '' || $("#ComponentAmount").val() == '' || $("#ComponentType").val() == '') {
            alert_error('Please select following', '<ul> <li>Month</li><li>Year</li><li>Type</li><li>Amount</li> </ul>');
            return;
        }

          $("#tblComponent").css('opacity', '0.2');
          var data = new FormData();

          data.append("EmpID", '@Model.ID');
          data.append("Month", $("#ComponentMonth").val());
          data.append("Year", $("#ComponentYear").val());
        data.append("ComponentType", $("#ComponentType").val());
          data.append("Amount", $("#ComponentAmount").val());
          data.append("Description", $("#ComponentDescription").val());

          $.ajax({
              cache: false,
              type: 'POST',
              processData: false,
              contentType: false,
              url: '/Employee/Edit/InsertComponent',
              data: data,
              success: function (result) {
                  RefreshComponent();
                  $("#tblComponent").css('opacity', 1);
              },
              error: function (xhr, ajaxOptions, thrownError) {
                  $("body").html(xhr.responseText);
              }
          });
    }

    function InsertQual() {
        if ($("#Qdegree").val() != '') {
            $("#tblQual").css('opacity', '0.2');
            var data = new FormData();

            data.append("ID", '@Model.ID');
            data.append("Type", 'Qual');
            data.append("Qual_Degree", $("#Qdegree").val());
            data.append("Qual_Board", $("#Qboard").val());
            data.append("Qual_Grade", $("#Qgrade").val());
            data.append("Qual_Marks", $("#Qmarks").val());
            data.append("Qual_Year", $("#Qyear").val());
            data.append("Qual_Remarks", $("#Qremarks").val());

            $.ajax({
                cache: false,
                type: 'POST',
                processData: false,
                contentType: false,
                url: '/Employee/Edit/Add',
                data: data,
                success: function (result) {
                    RefreshQual();
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("body").html(xhr.responseText);
                }
            });
        }
    }

    // INSERT SUBJECT
    function InsertSubject() {
        if ($("#SubjectID").val() != '') {
            $("#tblSubject").css('opacity', '0.2');
            var data = new FormData();

            data.append("ID", '@Model.ID');
            data.append("Type", 'Subject');
            data.append("SubjectID", $("#SubjectID").val());

            $.ajax({
                cache: false,
                type: 'POST',
                processData: false,
                contentType: false,
                url: '/Employee/Edit/Add',
                data: data,
                success: function (result) {
                    RefreshSubjects();
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("body").html(xhr.responseText);
                }
            });
        }
    }

    // INSERT SUBJECT
    function InsertExperience() {
        if ($("#Exp_Designation").val() != '') {
            $("#tblExp").css('opacity', '0.2');
            var data = new FormData();

            data.append("ID", '@Model.ID');
            data.append("Type", 'Exp');
            data.append("Exp_Designation", $("#Exp_Designation").val());
            data.append("Exp_DurationYears", $("#Exp_DurationYears").val());
            data.append("Exp_InstituteName", $("#Exp_InstituteName").val());
            data.append("Exp_FromDate", $("#Exp_FromDate").val());
            data.append("Exp_ToDate", $("#Exp_ToDate").val());

            $.ajax({
                cache: false,
                type: 'POST',
                processData: false,
                contentType: false,
                url: '/Employee/Edit/Add',
                data: data,
                success: function (result) {
                    RefreshExp();
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("body").html(xhr.responseText);
                }
            });
        }
    }

    function InsertAsset() {
        if ($("#Asset_Name").val() != '') {
            $("#tblAsset").css('opacity', '0.2');
            var data = new FormData();

            data.append("ID", '@Model.ID');
            data.append("Type", 'Asset');
            data.append("Asset_Name", $("#Asset_Name").val());
            data.append("Asset_AssetWorth", $("#Asset_AssetWorth").val());
            data.append("Asset_DateOfIssue", $("#Asset_DateOfIssue").val());
            data.append("Asset_Remarks", $("#Asset_Remarks").val());

            $.ajax({
                cache: false,
                type: 'POST',
                processData: false,
                contentType: false,
                url: '/Employee/Edit/Add',
                data: data,
                success: function (result) {
                    RefreshAssets();
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("body").html(xhr.responseText);
                }
            });
        }
    }

    //////////////////////////////////////////////////////////////////////////
    /////////////////////////////// TEMP LISTS ///////////////////////////////
    function RefreshComponent()
    {
        $.ajax({
            cache: false,
            type: 'Get',
            url: '/Employee/Edit/_SecrityAndLoan',
            data: { EmpID : '@Model.ID' },
            datatype: 'Json',
            success: function (result) {
                $("#tblComponent").css('opacity', '1');
                $("#tblComponent").html(result);

            },
            error: function (xhr, ajaxOptions, thrownError) {
                $("body").html(xhr.responseText);
            }
        });
    }

    function RefreshQual()
    {
        $.ajax({
            cache: false,
            type: 'Get',
            url: '/Employee/Edit/_Qual',
            data: { ID : '@Model.ID', Type: 'Qual' },
            datatype: 'Json',
            success: function (result) {
                $("#tblQual").css('opacity', '1');
                $("#tblQual").html(result);

                 var degreeName = '@Model.ProfessionalDegree';
                 $('input[name="ProfessionalDegree"][value="' + degreeName + '"]').prop('checked', true);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                $("body").html(xhr.responseText);
            }
        });
    }

    function RefreshExp() {
        $.ajax({
            cache: false,
            type: 'Get',
            url: '/Employee/Edit/_Exp',
            data: { ID : '@Model.ID', Type: 'Exp' },
            datatype: 'Json',
            success: function (result) {
                $("#tblExp").css('opacity', '1');
                $("#tblExp").html(result);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                $("body").html(xhr.responseText);
            }
        });
    }


    function RefreshSubjects() {
        $.ajax({
            cache: false,
            type: 'Get',
            url: '/Employee/Edit/_Subject',
            data: { ID : '@Model.ID', Type: 'Subject' },
            datatype: 'Json',
            success: function (result) {
                $("#tblSubject").css('opacity', '1');
                $("#tblSubject").html(result);

            },
            error: function (xhr, ajaxOptions, thrownError) {
                $("body").html(xhr.responseText);
            }
        });
    }

    function RefreshAssets() {
        $.ajax({
            cache: false,
            type: 'Get',
            url: '/Employee/Edit/_Asset',
            data: { ID : '@Model.ID' , Type: 'Asset' },
            datatype: 'Json',
            success: function (result) {
                $("#tblAsset").css('opacity', '1');
                $("#tblAsset").html(result);

            },
            error: function (xhr, ajaxOptions, thrownError) {
                $("body").html(xhr.responseText);
            }
        });
    }

    ///////////////////////////////////////////////////////
    ///////////////////////////////////////////////////////
    function DeleteRow(id, type) {
        $.ajax({
            cache: false,
            type: 'POST',
            url: '/Employee/Edit/Delete',
            data: { ID : id , Type : type },
            datatype: 'Json',
            success: function (result) {
                switch (type) {
                    case 'Qual':
                    RefreshQual();
                    break;
                    case 'Exp':
                        RefreshExp();
                    break;
                    case 'Subject':
                        RefreshSubjects();
                    break;
                    case 'Component':
                        RefreshComponent();
                    break;
                    default:
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                $("body").html(xhr.responseText);
            }
        });
    }

