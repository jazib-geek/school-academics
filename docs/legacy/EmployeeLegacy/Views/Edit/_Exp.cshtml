@model List<Data.DAL.tblEmployeeExperience>

<table class="table-bordered">
    <thead class="bg-soft-info">
        <tr>
            <th style="width:20%">Institute</th>
            <th style="width:20%">Designation</th>
            <th style="width:10%">Duration</th>
            <th style="width:10%">From</th>
            <th style="width:10%">To</th>
            <th style="width:5%"></th>
        </tr>
    </thead>
    <tbody style="background:white">
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.InstituteName</td>
                <td>@item.Designation</td>
                <td>@item.DurationYears</td>
                <td>@(item.FromDate != null ? item.FromDate.Value.ToShortDateString() : string.Empty)</td>
                <td>@(item.ToDate != null ? item.ToDate.Value.ToShortDateString() : string.Empty)</td>
                <td> <a href="javascript:;" class="text-danger" onclick="DeleteRow(@item.ID, 'Exp')"> <i class="la la-close"></i> </a> </td>
            </tr>
        }
        <tr>
            <td> <input type="text" id="Exp_InstituteName" class="form-control" /> </td>
            <td> <input type="text" id="Exp_Designation" class="form-control" /> </td>
            <td> <input type="text" id="Exp_DurationYears" class="form-control" /> </td>
            <td> <input type="text" id="Exp_FromDate" class="form-control datepicker" /> </td>
            <td> <input type="text" id="Exp_ToDate" class="form-control datepicker" /> </td>
            <td>   <a href="javascript:;" class="btn btn-sm btn-info" onclick="InsertExperience()"> <i class="la la-plus"></i> </a>  </td>
        </tr>

    </tbody>
</table>


<script>
    $(function () {
        $(".datepicker").datepicker({
            autoclose: true,
            todayHighlight: true
        }).datepicker();
    });
</script>