@model List<Data.DAL.tblEmployeeAsset>

<table class="table-bordered">
    <thead class="bg-soft-info">
        <tr>
            <th style="width:30%">Asset Name</th>
            <th style="width:10%">Value</th>
            <th style="width:10%">Date of issue</th>
            <th style="width:45%">Remarks</th>
            <th style="width:5%"></th>
        </tr>
    </thead>
    <tbody style="background:white">
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AssetName</td>
                <td>@item.AssetWorth</td>
                <td>@(item.DateOfIssue != null ? item.DateOfIssue.Value.ToShortDateString() : string.Empty)</td>
                <td>@item.Remarks</td>
                <td> <a href="javascript:;" class="text-danger" onclick="DeleteRow(@item.ID, 'Asset')"> <i class="la la-close"></i> </a> </td>
            </tr>
        }
        <tr>
            <td> <input type="text" id="Asset_Name" class="form-control" /> </td>
            <td> <input type="text" id="Asset_AssetWorth" class="form-control" /> </td>
            <td> <input type="text" id="Asset_DateOfIssue" class="form-control datepicker" /> </td>
            <td> <input type="text" id="Asset_Remarks" class="form-control" /> </td>
            <td>   <a href="javascript:;" class="btn btn-sm btn-info" onclick="InsertAsset()"> <i class="la la-plus"></i> </a>  </td>
        </tr>

    </tbody>
</table>

<script>
    $(function () {
        $(".datepicker").datepicker({
            autoclose: true,
            todayHighlight: true
        }).datepicker();
    });
</script>