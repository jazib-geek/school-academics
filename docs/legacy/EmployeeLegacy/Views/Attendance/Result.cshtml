@model System.Data.DataTable
@{
    ViewBag.Title = "Result";
}

@for (int i = 0; i < Model.Rows.Count; i++)
{
    <span> @Model.Rows[i][0] ------ @Data.BLL.DateFunctions.convertToStringDate(Convert.ToDateTime(Model.Rows[i][1])) -------- @Convert.ToDateTime(Model.Rows[i][1]).ToShortTimeString() -------- @Model.Rows[i][2] --------- @Model.Rows[i][3]  <br /> </span>
}

