
@{
    ViewBag.Title = "Import";
}

<div class="row main">
    <div class="col-md-8 offset-2 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <h2 class="text-center">
                    <i class="la la-edit"></i> ATTENDANCE DATA MANAGEMENT
                </h2>
            </div>
            <div class="body">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs tab-nav-right" role="tablist">
                    <li role="presentation" class="active"><a href="#import" data-toggle="tab"><i class="la la-file-import"></i> Import From Device</a></li>
                    <li role="presentation"><a href="#export" data-toggle="tab"><i class="la la-file-excel"></i> Export to Excel</a></li>
                </ul>

                <!-- Tab panes -->
                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane fade in active" id="import">
                        <div class="table-responsive adjust-top">
                            @using (Html.BeginForm("ImportData", "Attendance", FormMethod.Post, new { enctype = "multipart/form-data", @id = "importform" }))
                            {
                            <div class="col-md-9 offset-1">
                                <h5 class="text-center card" style="color:rgb(64, 81, 137)">
                                    <i class="fas fa-exclamation-circle"></i> Before importing Data, make sure that you have updated the <strong>Checkin Time </strong>
                                    for every <strong>Designation</strong>. The <strong>Late comings</strong> will be calculated on basis on your pre-defined
                                    <strong>Checkin Time</strong>, hence it will affect the <strong>Salary</strong> generated for respective month.
                                </h5>
                                <div class="well">
                                    <h5 class="text-center">
                                        Kindly upload valid .txt file generated from the ZKTeco Biometric Device
                                    </h5>
                                    <div>
                                        <input type="file" name="UploadedFile" id="file" onchange="getoutput()" style="margin-left:44%;" /> <br />
                                    </div>
                                    <h5 class="text-center">
                                        <input type="button" onclick="ImportNow()" id="btnsubmit" class="btn btn-lg btn-info" value="Import" disabled="disabled" />
                                        <button type="button" id="btnwait" class="btn btn-info btn-lg hide" value="Import" disabled="disabled">
                                            <i class="la la-spin fa-spinner"></i> Importing Data
                                        </button>
                                    </h5>
                                </div>
                            </div>
                            }

                        </div>

                    </div>


                    <div role="tabpanel" class="tab-pane fade" id="export">
                        <div class="row">
                            <div class="col-md-6 offset-2">
                                <div class="form-group">
                                    <label>Month</label>
                                    <select id="Month" class="form-control">
                                        @for (int i = 1; i <= 12; i++)
                                        {
                                            <option value="@i">@Data.BLL.DateFunctions.convertToStringMonth(i)</option>
                                        }
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label>Year</label>
                                    <select id="Year" class="form-control">
                                        <option value="@(DateTime.Now.Year-1)">@(DateTime.Now.Year-1)</option>
                                        <option value="@(DateTime.Now.Year)" selected="selected">@(DateTime.Now.Year)</option>
                                        <option value="@(DateTime.Now.Year+1)">@(DateTime.Now.Year+1)</option>
                                    </select>
                                </div>

                                <div class="text-center">
                                    <button type="button" class="btn btn-info" onclick="ExportData()">
                                        <i class="la la-file-excel"></i> Export
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


<script>
    function getoutput() {
        var file_type = file.value.split('.')[1];
        if (file_type == 'txt') {
            $("#btnsubmit").removeAttr('disabled');
        }
        else {
            alert_error('Kindly upload valid txt file!');
            $("#btnsubmit").attr('disabled', true);
        }
    }

    function ImportNow() {
        $("#btnsubmit").addClass('hide');
        $("#btnwait").removeClass('hide');
        document.getElementById('importform').submit();
    }

    @if (TempData["success"] != null)
    {
     <text>
         $(document).ready(function () {
               alert_success('Data imported successfully','');
         });
     </text>
    }

    $(document).ready(function () {
        $("#Month").val('@DateTime.Now.Month');
    });

    function ExportData() {
        window.location.href = '/Staff/Attendance/ExportAttendanceData/?m=' + $("#Month").val() + '&y=' + $("#Year").val();
    }
</script>

