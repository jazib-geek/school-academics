@using Data.BLL.Staff
@{
    ViewBag.Title = "Holiday";
    Layout = "~/Areas/Staff/Views/Shared/LayoutEmp.cshtml";
}

<div class="row">
    <div class="col-md-6 offset-3">
        <div class="card">
            <div class="header">
                <h5 class="title text-center text-green"> <span class="la la-edit"></span> &nbsp;MARK LEAVE</h5>
                <p class="category"></p>
            </div>
            <div class="content">

                <div class="row">
                    <div class="col-md-6 offset-3">
                        <div class="inbox-details-default">
                            <div class="inbox-details-body">
                                <label for="day">Day <i class="la la-caret-down"></i> </label>
                                <select id="emp" class="form-control">
                                    @foreach (var item in Teachers.lstTeacher().Where(x => x.IsActive == true))
                                    {
                                        <option value="@item.ID">@item.TeacherName</option>
                                    }
                                </select>

                                <br />
                                <label for="day">Day <i class="la la-caret-down"></i> </label>
                                <select id="day" class="form-control">
                                    @for (int i = 1; i <= 31; i++)
                                    {
                                        <option value="@i">@i</option>
                                    }
                                </select>
                                <br />

                                <label for="month">Month <i class="la la-caret-down"></i> </label>
                                <select id="month" class="form-control">
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <option value="@i">@Data.BLL.DateFunctions.convertToStringMonth(i)</option>
                                    }
                                </select>
                                <br />

                                <label for="year">Year <i class="la la-caret-down"></i> </label>
                                <select id="year" class="form-control">
                                    @for (int i = 2018; i <= 2025; i++)
                                    {
                                        <option value="@i">@i</option>
                                    }
                                </select>
                                <br />

                                <div class="text-center">
                                    <button type="button" onclick="mark_leave()" id="btnUpdate" class="btn btn-info">
                                        <span class="la la-plus"></span> Mark Leave
                                    </button>
                                </div>
                                <br />

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="clearfix"> </div>

<script type="text/javascript">
    function mark_leave() {
        $("#btnUpdate").attr('disabled', true);

        $.ajax({
            cache: false,
            type: 'POST',
            url: '/Staff/Attendance/Leave',
            data: { EmpID: $("#emp").val() , Day: $("#day").val(), Month: $("#month").val(), Year: $("#year").val() },
            datatype: 'Json',
            success: function (result) {
                $.alert(result.msg);
                $("#btnUpdate").removeAttr('disabled');
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert('error');
            }
        });
    }

    $("#day").val(@DateTime.Now.Day);
    $("#month").val(@DateTime.Now.Month);
    $("#year").val(@DateTime.Now.Year);

</script>

<style>
    label {
        color: #176da5;
    }

    h5 {
        padding-top: 16px;
        padding-bottom: 16px;
        background: #176da5;
        color: white;
    }
</style>
