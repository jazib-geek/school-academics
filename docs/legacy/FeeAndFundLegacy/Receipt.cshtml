                <h6 style="font-size:12px!important;line-height:0.6!important;font-family:Arial!important">@System.Web.Configuration.WebConfigurationManager.AppSettings["campus_name"]</h6>
                <h6 style="font-size:12px!important;line-height:0.6!important;padding-bottom:0.5em;font-family:Arial!important">Phone : 055-@System.Web.Configuration.WebConfigurationManager.AppSettings["campus_landline"], @System.Web.Configuration.WebConfigurationManager.AppSettings["campus_mobile"]</h6>
            </div>
        </div>

        <div class="divInfo">
            <div class="master-block-upper">
                <div class="child-block-upper-left">
