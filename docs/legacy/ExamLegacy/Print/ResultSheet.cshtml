@model Data.Viewmodel.ExamSheetViewModel
@using Data.BLL

@{
    Layout = null;
    var SUbjectList = Model.lstDistinctSubject;
    int? Percentage = 0;
    string Grade = "";
    int serial = 0;
}

<!DOCTYPE html>
<html>

<head>
    <link href="~/css/bootstrap-theme.css" type="text/css" rel="stylesheet" media="all" />
    <link href="~/css/bootstrap-responsive.min.css" rel="stylesheet" media="all" />
    <script src="~/Scripts/jquery-3.3.1.min.js"></script>

    @Scripts.Render("~/bundles/bootstrap")
    <style>
        @@page {
            /*margin: 20px !important;*/
            width: 100%;
        }


        body {
            font-family: Arial !important;
        }

        h2 {
            font-size: 18px !important;
            font-weight: bold !important;
        }

        h3 {
            font-weight: bold !important;
            font-size: 18px !important;
            font-family: 'Arial' !important;
            margin-top: 8px !important;
        }


        h4 {
            font-size: 14px !important;
            font-weight: bold !important;
            margin-left: 40px !important;
        }

        th {
            font-size: 13px !important;
            font-family: Arial !important;
        }

        td {
            font-size: 13px !important;
            font-family: Arial !important;
            padding: 3px !important;
            line-height: 1.2 !important;
            color: black !important;
        }

        .table-bordered > thead > tr > th, .table-bordered > tbody > tr > th, .table-bordered > tfoot > tr > th, .table-bordered > thead > tr > td, .table-bordered > tbody > tr > td, .table-bordered > tfoot > tr > td {
            border: 1px solid black !important;
        }

        .table-bordered {
            border: 1px solid black !important;
        }

        tfoot {
            height: 34px !important;
        }

            tfoot tr td {
                font-size: 14px !important;
            }

        /*td {
            font-size: 14px !important;
            font-family: Arial important;
            padding: 2px !important;
            line-height: 0.9 !important;
            color: black !important;
        }*/
    </style>
</head>
<body>
    <div id="MainDiv">
        <div style="max-width:100%;">
            <div class="col-xs-4 pull-left" style="padding-left:0px !important;font-size:15px!important;height:60px!important;">
                <h4 style="font-weight:normal;font-family:Arial!important;font-size:12px!important;"> EXAM RESULT SHEET : 
                @Data.BLL.Exam.GetExamtypeType(Model.ExamTypeID).ToUpper() 
                @if (string.IsNullOrEmpty(Request.QueryString["sort"]))
                {
                    <span>(Position wise)</span>
                }
                else
                {
                    <span>(Roll No. wise)</span>
                }
                </h4>
                <h4 style="font-weight:normal;font-family:Arial!important">
                    @Data.BLL.DateFunctions.GetCurrentDate() &nbsp; 
                </h4>
                <br />
            </div>
            <div class="col-xs-1">
            </div>
            <div class="col-xs-3 text-center">
                <h3 style="font-weight:bold; font-size:20px !important">SCIENCE BASE SCHOOL </h3>
                <h5 style="font-family:arial!important;font-weight:bold!important;font-size:16px !important"> @System.Web.Configuration.WebConfigurationManager.AppSettings["campus_name"] </h5>
            </div>
            <div class="col-xs-4 pull-right" style="padding-right:0px !important;font-size:14px!important;text-align:center !important">
                <h4 style="font-weight:normal;font-family:Arial!important">Class : @Data.BLL.Parameter.ClassAndSection.GetByID(Model.ClassID)</h4>
                <h4 style="font-family:Arial!important;font-size:15px!important;padding-right:43px!important">Strength &nbsp;:&nbsp; @Model.lstStudent.Count</h4>
            </div>
        </div>
        <table class="table table-bordered" style="border-collapse:unset!important; border-radius:0px;">
            <thead class="bg-soft-info">
                <tr class="row-head">
                    <th></th>
                    <th style="font-size:10px !important">Reg no.</th>
                    <th>Student Name</th>

                    @foreach (var item in SUbjectList)
                    {
                        <th>@Subjects.GetByID(item.SubjectID).ShortName</th>
                    }
                    <th>Attendance</th>
                    <th>Total</th>
                    <th>Position</th>
                    <th>Percentage</th>
                    <th>Grade</th>
                    <th>Remarks</th>
                </tr>
            </thead>


            <tbody>
                <tr class="top-row row-head">
                    <td></td>
                    <td colspan="2">Total Marks</td>
                    @foreach (var item in SUbjectList)
                    {
                        <td class="total_marks" id="total_marks_@item.SubjectID">@Exam.GetRow(Model.ExamTypeID, item.SubjectID, Model.ClassID).TotalMarks</td>
                    }
                    <td></td>

                    <td style="font-weight:bold">
                        @Exam.GetSumOfTotalMarksOfThisExam(Model.ClassID, Model.ExamTypeID)
                    </td>
                    <td colspan="4"></td>
                </tr>

                <tr class="top-row row-head">
                    <td></td>
                    <td colspan="2">Passing Marks</td>
                    @foreach (var item in SUbjectList)
                    {
                        <td class="passing_marks">@Exam.GetRow(Model.ExamTypeID, item.SubjectID, Model.ClassID).PassingMarks</td>
                    }
                    <td></td>
                    <td></td>
                    <td colspan="4"></td>
                </tr>

                <tr class="top-row row-head">
                    <td></td>
                    <td colspan="2">Max Marks</td>
                    @foreach (var item in SUbjectList)
                    {
                        <td>@Exam.GetMaxMarks(Model.ClassID, Model.SectionID, item.SubjectID, Model.ExamTypeID)</td>
                    }
                    <td></td>
                    <td></td>
                    <td colspan="4"></td>
                </tr>

                @foreach (var item in Model.lstStudent)
                {
                    { serial++; }
                    <tr style="background-color:white">
                        <td class="serial">@serial</td>
                        <td style="width:60px">@item.Reg_Id</td>
                        <td style="max-width:200px">
                            @item.FullName
                        </td>
                        @{ int cellnumber = 0; }
                        @foreach (var item_ in Exam.lstExam(item.Reg_Id, Model.ClassID, Model.ExamTypeID).OrderBy(x => x.SubjectID).ToList())
                        {
                            { cellnumber += 1; }
                            if (item_.ObtainedMarks != -1)
                            {
                                <td class="obt_marks" data-subjectid="@item_.SubjectID" data-marks="@item_.ObtainedMarks"> @item_.ObtainedMarks </td>
                            }
                            else
                            {
                                <td> A </td>
                            }
                        }
                        <td>
                            @Exam.GerAttendanceRatio(item.Reg_Id, Model.ExamTypeID)
                        </td>
                        <td style="background-color:rgba(128, 128, 128, 0.07);color:black;font-weight:bold;">
                            <label id="@item.Reg_Id"> @Exam.GetTotalMarksObtained(item.Reg_Id, Model.ExamTypeID)</label>
                        </td>

                        <td>
                            @{ Percentage = Data.BLL.Exam.GetPercentage(Data.BLL.Exam.GetTotalMarksObtained(item.Reg_Id, Model.ExamTypeID), Data.BLL.Exam.GetSumOfTotalMarksOfThisExam(Model.ClassID, Model.ExamTypeID)); }
                            @Exam.PositionWithPostFix(Data.BLL.Exam.GetPosition(item.Reg_Id, Model.ExamTypeID))
                        </td>
                        <td>
                            @Percentage%
                        </td>
                        <td>
                            @{Grade = Data.BLL.Exam.GetGrade(Percentage); }
                            @Grade
                        </td>
                        <td>
                            @Data.BLL.Exam.GetRemarks(Grade)
                        </td>
                    </tr>
                }
            </tbody>
            <tr class="well" style="text-align:center!important; font-weight:bold !important">
                <td></td>
                <td></td>
                <td style="padding-top:7px!important">Subject Percentage</td>
                @foreach (var item in Model.lstDistinctSubject)
                {
                    <td style="padding-top:7px!important" id="subj_perc_@item.SubjectID">
                        @*@Exam.GetSubjectPercentage(Model.ClassID, item.SubjectID, Model.ExamTypeID)*@
                        ...
                    </td>
                }
            </tr>
        </table>
    </div>
</body>
</html>
<script>
    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;

        document.body.innerHTML = printContents;

        window.print();

        document.body.innerHTML = originalContents;
    }

    $(document).ready(function () {
        // printDiv('MainDiv');


        var totals = {};
        var percentages = {};
        var totalMarks = $('.total_marks').first().html();

        // Iterate over each cell with class 'obt_marks'
        $('.obt_marks').each(function () {
            const subjectId = $(this).data('subjectid');
            const marks = parseInt($(this).data('marks'), 10);

            // Accumulate marks for each subject
            totals[subjectId] = (totals[subjectId] || 0) + marks;
        });

        // Calculate grand total (optional for percentage calculation)
        totalMarks = Object.values(totals).reduce((sum, val) => sum + val, 0);

        // Calculate percentages
        for (let subjectId in totals) {
            percentages[subjectId] = ((totals[subjectId] / totalMarks) * 100).toFixed(2);
        }

        // Display results
        for (let subjectId in totals) {
            console.log(`s-${subjectId}`);
            console.log(`${totals[subjectId]}`);
            var totalStrength = parseInt($(`.obt_marks[data-subjectid="${subjectId}"]`).length);
            var sum_obtainedmarks = `${totals[subjectId]}`;
            var totalMarksOfSubject = parseInt($(`#total_marks_${subjectId}`).html())
            var averege = parseInt(sum_obtainedmarks)/totalStrength;

            var calc = parseFloat(averege/totalMarksOfSubject);

            var result = calc * 100;
            console.log(`p-${totalMarksOfSubject}`);
            $(`#subj_perc_${subjectId}`).html(Math.ceil(result));
        }



    });
</script>