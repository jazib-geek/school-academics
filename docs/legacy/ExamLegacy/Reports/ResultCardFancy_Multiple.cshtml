@model List<Data.DAL.v_StudentList>
@{
    Layout = null;
    int? ExamTypeID = ViewBag.ExamTypeID;
}

@foreach (var item in Model)
{
    @Html.Partial("_ResultCardAdvanced", Data.BLL.Exam.GetResultCard(item.Reg_Id, ExamTypeID), new ViewDataDictionary() { { "ExamTypeID", ExamTypeID } })
}

