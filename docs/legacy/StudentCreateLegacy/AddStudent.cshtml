@using Data.BLL
@model Data.Viewmodel.StudentViewModel
@{
    var lstFundType = Data.BLL.Student.Parameters.lstFundType();
    string Type1 = lstFundType.Where(x => x.ID == 2).First().FundType;
    string Type2 = lstFundType.Where(x => x.ID == 3).First().FundType;
    string Type3 = lstFundType.Where(x => x.ID == 4).First().FundType;
    string Type4 = lstFundType.Where(x => x.ID == 5).First().FundType;
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.3.0/js/bootstrap-datepicker.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.3.0/css/datepicker.css" rel="stylesheet" type="text/css" />

@Html.Partial("_js_AddStudent")

<div style="line-height:inherit !important; margin-bottom:1.5em;" class="main">

    @using (Html.BeginForm("Create", "Student", FormMethod.Post, new { id = "CreateStudentForm", @autocomplete = "off" }))
    {
    <div class="inner-container">
        <div class="heading-bar">
          <i class="material-icons text-white" style="vertical-align:middle">school</i> Admission Form
        </div>

        <div class="inner-col">
            <div class="left">
                <div class="inner-left">
                    Name (In English) &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="FullName" class="input-borderless" />
                </div>
            </div>
            <div class="right">
                <div class="inner-left">
                    Name (In Urdu) &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="NameInUrdu" class="input-borderless" />
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="full">
                <div class="left-15">
                    Address &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="right-85">
                    <input type="text" id="Home_Address" class="input-borderless" />
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="left">
                <div class="inner-left">
                    Locality &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <select class="input-borderless" id="LocalityID">
                        <option value="">----</option>
                    </select>
                </div>
            </div>
            <div class="right">
                <div class="inner-left">
                    Caste &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="Caste" class="input-borderless" />
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="left">
                <div class="inner-left">
                    Gender &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right" style="padding-top: 7px !important;">
                    @Html.RadioButtonFor(m => m.Gender, "Male", new { @id = "rbMale", @style = "margin: -8px 0 0 !important", @checked = "checked" })&nbsp;
                    <label for="rbMale">Male</label>
                    &nbsp; &nbsp; &nbsp;
                    @Html.RadioButtonFor(m => m.Gender, "Female", new { @id = "rbFeMale", @style = "margin: -8px 0 0 !important" })&nbsp;
                    <label for="rbFeMale">Female</label>
                </div>
            </div>
            <div class="right">
                <div class="inner-left">
                    Orphan/Hafiz &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right" style="padding-top: 7px !important;">
                    <input type="checkbox" name="IsOrphan" id="IsOrphan"  />
                    <label for="IsOrphan">Orphan</label>
                    &nbsp; &nbsp; &nbsp;
                    <input type="checkbox" name="IsHafiz" id="IsHafiz" />        
                    <label for="IsHafiz">Hafiz</label>

                    <div style="float:right; background:white">
                        @Html.RadioButtonFor(m => m.Religion, "Muslim", new { @id = "rbMuslim" })&nbsp;
                        <label for="rbMuslim" style="margin-bottom:0px">Muslim</label>
                        &nbsp;
                        @Html.RadioButtonFor(m => m.Religion, "Non-Muslim", new { @id = "rbNonMuslim" })&nbsp;
                        <label for="rbNonMuslim" style="margin-bottom:0px">Non-Muslim</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="left">
                <div class="inner-left">
                    Date of Birth &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="Date_of_Brith" class="input-borderless" />
                </div>
            </div>
            <div class="right">
                <div class="inner-left">
                    Form-B No. &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="B_FormNum" class="input-borderless" />
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="left">
                <div class="inner-left">
                    Subject Group &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    @Html.DropDownListFor(m => m.SubjectGroupID, new List<SelectListItem> { }, "", new { @class = "input-borderless", @id = "ddlSubject" })
                </div>
            </div>
            <div class="right">
                <div class="inner-left">
                    Medium &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <select id="Medium" class="input-borderless">
                        <option value="English">English</option>
                        <option value="Urdu">Urdu</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="left">
                <div class="inner-left">
                    Previous School &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="PrevSchoolName" class="input-borderless" />
                </div>
            </div>
            <div class="right">
                <div class="inner-left">
                    Previous Class &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="PrevSchoolClass" class="input-borderless" />
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="left">
                <div class="inner-left">
                    Father Name &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="FatherName" class="input-borderless" />
                </div>
            </div>
            <div class="right">
                <div class="inner-left">
                    Mother Name &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="MotherName" value="-" class="input-borderless" />
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="left">
                <div class="inner-left">
                    Father CNIC &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="FatherCNIC" value="-" class="input-borderless" />
                </div>
            </div>
            <div class="right">
                <div class="inner-left">
                    Mother CNIC &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="MotherCnic" value="-" class="input-borderless" />
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="left">
                <div class="inner-left">
                    Father Qualification &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    @Html.DropDownListFor(m => m.FatherQualificationID, new List<SelectListItem> { }, new { @class = "input-borderless", @id = "ddlFatherQualif" })
                </div>
            </div>
            <div class="right">
                <div class="inner-left">
                    Mother Qualification &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    @Html.DropDownListFor(m => m.MotherQualificationID, new List<SelectListItem> { }, new { @class = "input-borderless", @id = "ddlMotherQualif" })

                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="left">
                <div class="inner-left">
                    Father Mobile No.&nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="FatherContactNumber" value="-" class="input-borderless" />
                </div>
            </div>
            <div class="right">
                <div class="inner-left">
                    Mother Mobile No. &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="MotherPhoneNo" value="-" class="input-borderless" />
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="left">
                <div class="inner-left">
                    Father Occupation &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    @Html.DropDownListFor(m => m.FatherOccupationID, new List<SelectListItem>
                                         { }, "", new { @class = "input-borderless", @id = "FatherOccupationID", @onchange = "chk()" })
                </div>
            </div>
            <div class="right">
                <div class="inner-left">
                    Home Phone &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="HomePhone" value="-" class="input-borderless" />
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="full">
                <div class="left-15">
                    Siblings &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="right-85">
                    <input type="text" class="input-borderless" id="Siblings" style="font-size:10px !important" disabled />
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="full">
                <div class="left-15">
                    Special Notes &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="right-85">
                    <input type="text" id="Notes" value="-" class="input-borderless" />
                </div>
            </div>
        </div>

        @*UPPER SECTION END*@

        @*OFFICE USE SECTION START*@

        <div class="heading-bar">
            FOR OFFICE USE
        </div>

        <div class="inner-col">
            <div class="div-33">
                <div class="inner-left">
                    Reg Date &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="Reg_Date" class="input-borderless" />
                </div>
            </div>

            <div class="div-33">
                <div class="inner-left">
                    Reg No. &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" class="input-borderless" value="[Autogenerate]" disabled />
                </div>
            </div>

            <div class="div-33">
                <div class="inner-left">
                    Family Code &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="Family_ID" class="input-borderless" onkeypress="return isNumber(event)" onchange="GetFamilyInfo()" style="width:70% !important" />
                    <a class="label label-success" value="generate" onclick="GenerateFamilyCode()" id="btnCode" style="margin-right:5px"> <i class="la la-plus-circle"></i> </a>
                    <a class="label label-danger" onclick="btnClear()"> <i class="la la-close"></i> </a>
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="div-33">
                <div class="inner-left">
                    Class &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <select id="ClassCompositeID" class="input-borderless" onchange="getFee()">
                        <option value="">--select--</option>
                        @foreach (var item in Data.BLL.Student.Parameters.ListOfClass().Where(x=>x.IsActive == true))
                        {
                            <option value="@item.ID">@item.ClassName</option>
                        }
                    </select>
                </div>
            </div>

            <div class="div-33">
                <div class="inner-left">
                    Branch &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" class="input-borderless" value="@System.Web.Configuration.WebConfigurationManager.AppSettings["Branch"]" disabled />
                </div>
            </div>

            <div class="div-33">
                <div class="inner-left">
                    Session &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="SessionSpan" class="input-borderless" />
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="div-33">
                <div class="inner-left">
                    Class Fee &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="TutionFee" class="input-borderless" />
                </div>
            </div>

            <div class="div-33">
                <div class="inner-left">
                    Tution Fee &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="ActualFee" class="input-borderless" onkeyup="CalculateFee()" onkeypress="return isNumber(event)" />
                </div>
            </div>

            <div class="div-33">
                <div class="inner-left">
                    Concession &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right">
                    <input type="text" id="FeeConcession" class="input-borderless" readonly="readonly" />
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="div-25">
                <div class="inner-left-small">
                    @Type1  &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right-small">
                    <input type="text" id="AdmissionFee" class="input-borderless" />
                </div>
            </div>

            <div class="div-25">
                <div class="inner-left-small">
                    @Type2 &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right-small">
                    <input type="text" id="FundType_1" class="input-borderless" />
                </div>
            </div>

            <div class="div-25">
                <div class="inner-left-small">
                    @Type3 &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right-small">
                    <input type="text" id="FundType_2" class="input-borderless" />
                </div>
            </div>

            <div class="div-25">
                <div class="inner-left-small">
                    @Type4 &nbsp; <i class="la la-caret-right gray"></i> &nbsp;
                </div>
                <div class="inner-right-small">
                    <input type="text" id="FundType_3" class="input-borderless" />
                </div>
            </div>
        </div>

        <div class="inner-col">
            <div class="text-center top-10">
                <input type="button" id="btnSubmit" class="btn btn-primary" value="Save" onclick="SubmitByAjax()" />
            </div>
        </div>
    </div>
    }
</div>

@Html.Partial("_AddLoc")

<script>
    $(document).ready(function () {
        ddlOccupation();
        ddlLocality();
        ddlQualification();
        ddlSubject();
    });

    //// DATE PICKERS START /////
    $(function () {
        $("#Date_of_Brith").datepicker({
            autoclose: true,
            todayHighlight: true
        }).datepicker();
    });

    $(function () {
        $("#Reg_Date").datepicker({
            autoclose: true,
            todayHighlight: true
        }).datepicker();
    });

    //// DATE PICKERS END /////

    function GenerateFamilyCode() {
        $.ajax({
            cache: false, async: false, type: "POST",
            url: '/Student/AjaxMethods/GenerateFamilyCode',
            data: {},
            success: function (result) {
                $("#Family_ID").val(result.family_code);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                EmptyAllFamilyControls();
                alert(xhr.responseText);
            }
        });
    }

    // Save to DB

    function SubmitByAjax() {

        if ($("#FullName").val() == '' || $("#LocalityID").val() == 0 || $("#FatherName").val() == '' || $("#Father_CNIC").val() == '' ||
            $("#Family_ID").val() == '' || $("#FatherOccupationID").val() == 0 || $("#FatherContact_Number").val() == '' ||
            $("#MotherPhoneNo").val() == '' || $("#MotherCnic").val() == '' || $("#ClassCompositeID").val() == '' ||
            $("#Home_Address").val() == '' || $("#AdmissionFee").val() == '' || $("#FundType_1").val() == '' || $("#FundType_2").val() == ''
            || $("#FundType_3").val() == '' || $("#Medium").val() == ''  ||
            $("#ddlMotherQualif").val() == 0 || $("#ddlFatherQualif").val() == 0) {

            alert_warning('Incomplete input','Please fill all *Required fields');
        }
        else {
            $("#btnSubmit").attr('disabled', true);

            var data = new FormData();

            data.append("FullName", $("#FullName").val());
            data.append("StudentType", $("#StudentType").val());
            data.append("ClassCompositeID", $("#ClassCompositeID").val());
            data.append("Date_of_Brith", $("#Date_of_Brith").val());
            data.append("LocalityID", $("#LocalityID").val());
            data.append("Caste", $("#Caste").val());
            data.append("Mark_Of_Identification", $("#Mark_Of_Identification").val());
            data.append("Gender", $('[name="Gender"]:checked').val());
            data.append("Religion", $('[name="Religion"]:checked').val());
            data.append("IsOrphan", $('input[name="IsOrphan"]:checked').val());
            data.append("IsHafiz", $('input[name="IsHafiz"]:checked').val());
            data.append("Notes", $("#Notes").val());
            data.append("PrevSchoolName", $("#PrevSchoolName").val());
            data.append("PrevSchoolClass", $("#PrevSchoolClass").val());
            data.append("Family_ID", $("#Family_ID").val());
            data.append("Home_Address", $("#Home_Address").val());
            data.append("SMS_Contact", $("#SMS_Contact").val());

            data.append("FatherName", $("#FatherName").val());
            data.append("FatherCNIC", $("#FatherCNIC").val());
            data.append("FatherEmail", $("#FatherEmail").val());
            data.append("FatherOccupationID", $("#FatherOccupationID").val());
            data.append("FatherQualificationID", $("#ddlFatherQualif").val());
            data.append("FatherContactNumber", $("#FatherContactNumber").val());
            data.append("LearningMode", $("#LearningMode").val());

            data.append("MotherName", $("#MotherName").val());
            data.append("MotherCnic", $("#MotherCnic").val());
            data.append("MotherPhoneNo", $("#MotherPhoneNo").val());
            data.append("MotherQualificationID", $("#ddlMotherQualif").val());

            data.append("Class_ID", $("#ddl").val());
            data.append("Section_ID", $("#ddlSection").val());
            data.append("Medium", $("#Medium").val());
            data.append("SubjectGroupID", $("#ddlSubject").val());
            data.append("SMS_Contact", $("#SMS_Contact").val());

            data.append("TutionFee", $("#TutionFee").val());
            data.append("FeeConcession", $("#FeeConcession").val());
            data.append("ActualFee", $("#ActualFee").val());
            data.append("AdmissionFee", $("#AdmissionFee").val());
            data.append("FundType_1", $("#FundType_1").val());
            data.append("FundType_2", $("#FundType_2").val());
            data.append("FundType_3", $("#FundType_3").val());
            data.append("SessionSpan", $("#SessionSpan").val());

            data.append("RollNum", $("#RollNum").val());
            data.append("FinanceType", $("#FinanceType").val());
            data.append("StudentContact", $("#StudentContact").val());
            data.append("Sponsor", $("#Sponsor").val());
            data.append("Church", $("#Church").val());
            data.append("Email", $("#Email").val());


            $.ajax({
                cache: false,
                type: 'POST',
                processData: false,
                contentType: false,
                url: '/AjaxMethods/SaveStudent',
                data: data,
                success: function (result) {
                    $("#btnSubmit").removeAttr('disabled');
                    ResetForm();
                    alert_success('Student Registered', 'Student List updated');
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(xhr.responseText);
                }
            });
        }

    }


    function ResetForm() {
        EmptyAllFamilyControls();

        $("#FullName").val('');
        $("#Date_of_Brith").val('');
        $("#B_FormNum").val('');
        $("#Caste").val('');
        $("#Mark_Of_Identification").val('');
        $("#PrevSchoolName").val('');
        $("#PrevSchoolClass").val('');
        $("#SMS_Contact").val('');
        $("#Notes").val('');
        $("#Fee").val('');
        $("#FeeConcession").val('');
        $("#ActualFee").val('');
        $("#AdmissionFee").val('');
        $("#FundType_1").val('');
        $("#FundType_2").val('');
        $("#FundType_3").val('');


        ddlOccupation();
        ddlLocality();
        ddlQualification();
        ddlSubject();

    }

     @if (Data.BLL.User.Rights.UserHasAccessToMudule("add_std", Session["user"].ToString()) == false)
    {
        <text>  $(".main").html(''); $(".main").html('<h4 class="alert alert-danger text-center"> <i class="la la-exclamation-circle"> You do not have permission to access this feature </h4>');   </text>
     }

</script>


