    <script>

    $(document).ready(function () {
        $('#CreditAccount').select2();
    });

    function InsertRow() {
        if ($("#Date").val() != '' && $("#Amount").val() != '' && $("#Narration").val() != '' && $("#DebitAccount").val() != '') {
              $(".table").css('opacity', '0.2');
            var data = new FormData();
            data.append("Hash", '@Model.Hash');
            data.append("DebitAccount", '@CashAccount');
            data.append("CreditAccount", $("#CreditAccount").val());
            data.append("Amount", $("#Amount").val());
            data.append("Narration", $("#Narration").val());
            data.append("Date", $("#Date").val());
            data.append("VoucherType", '@VoucherType');

            $("#btnAdd").attr('disabled', true);

            $.ajax({
                cache: false,
                type: 'POST',
                processData: false,
                contentType: false,
                url: '/Accounts/Voucher/InsertTempReceipt',
                data: data,
                datatype: 'Json',
                success: function (result) {
                    $("#Amount").val('');
                    $("#Narration").val('');
                    GetList();
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(xhr.responseText);
                }
            });
        }
        else {
            alert_error('Incomplete Input', 'Debit Acc , Date & Amount is required');
        }
    }


     function SaveVoucher() {
        $.ajax({
            cache: false,
            type: 'POST',
            url: '/Accounts/Voucher/SaveVoucher',
            data: { Hash: '@Model.Hash', Date: $("#Date").val() },
            datatype: 'Json',
            success: function (result) {
                $("#table-content").html('');
                $("#Date").val('');
                $("#Amount").val('');
                $("#Narration").val('');
                alert_success('Voucher Saved', 'Data saved successfully');
                OpenNewTab('/Accounts/Voucher/Print/' + result.VCode);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                $('body').html(xhr.responseText);
            }
        });
    }

    function GetList() {
        $.ajax({
            cache: false,
            type: 'Get',
            url: '/Accounts/Voucher/_Index',
            data: { Hash : '@Model.Hash' },
            datatype: 'Json',
            success: function (result) {
               // $("#loading").addClass('hide');
                $("#btnAdd").attr('disabled', false);
                $("#table-content").removeClass('hide');
                  $(".table").css('opacity', '1');
                $("#table-content").html(result);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert('error');
            }
        });
    }

    $(function () {
        $("#Date").datepicker({
            autoclose: true,
            todayHighlight: true
        }).datepicker();
    });

     @if (Data.BLL.User.Rights.UserHasAccessToMudule("issue_voucher", Session["user"].ToString()) == false)
    {
        <text>  $(".main").html(''); $(".main").html('<h4 class="alert alert-danger text-center"> <i class="la la-exclamation-circle"> You do not have permission to access this feature </h4>');   </text>
     }

    function CallOnAmountTxt(e) {
        if (e.keyCode == 13) {
            InsertRow();
        }
    }
    </script>

