@model Data.DAL.tblTransactionDetail



<div class="form-group">
    <label for="Date">Date</label>
    <input type="text" class="form-control" id="Date" value="@Model.Date.Value.ToShortDateString()">
</div>

<div class="form-group">
    <label for="Date">Account</label>
    <select id="AccountID">
        @foreach (var item in Data.BLL.Accounts.Chart.ListAccount())
        {
            <option value="@item.AccountID">@item.AccountTitle</option>
        }
    </select>
</div>

<div class="form-group">
    <label for="Debit">Debit</label>
    <input type="text" class="form-control" id="Debit" value="@Model.Debit">
</div>

<div class="form-group">
    <label for="Credit">Credit</label>
    <input type="text" class="form-control" id="Credit" value="@Model.Credit">
</div>

<div class="form-group">
    <label for="Narration">Narration</label>
    <textarea class="form-control" id="Narration">@Model.Narration </textarea>
</div>

<div class="text-center">
    <input type="button" class="form-control" value="Update">
</div>