@model List<Data.Viewmodel.Account.AccountLedgerViewModel>
@using Data.BLL.Accounts
@{
    Layout = "~/Views/Shared/_LayoutReport.cshtml";

    decimal? FEE = Data.BLL.FeeAndFund.Collection.ByInterval(ViewBag.From, ViewBag.To, 1);
    decimal? ADM = Data.BLL.FeeAndFund.Collection.ByInterval(ViewBag.From, ViewBag.To, 2);
    decimal? MISC = Data.BLL.FeeAndFund.Collection.ByInterval(ViewBag.From, ViewBag.To, 3);
    decimal? PREV = Data.BLL.FeeAndFund.Collection.ByInterval(ViewBag.From, ViewBag.To, 4);
    decimal? FINE = Data.BLL.FeeAndFund.Collection.ByInterval(ViewBag.From, ViewBag.To, 6);

    decimal? OWNER = 0;

    decimal ownerTotal = 0;
    decimal expenseTotal = 0;
    string ownerAccountID = System.Configuration.ConfigurationManager.AppSettings.Get("ownerAccountID");
    string ownerAccountCaption = System.Configuration.ConfigurationManager.AppSettings.Get("ownerAccountCaption");
    int? ownerRecevingId = 0;
}

<script src="~/Scripts/jquery-1.10.2.min.js"></script>

<table cellpadding="0" cellspacing="0" style="width:100%;">
    <tr>
        <td class="top">
            @Html.Partial("_CampusDetail")
        </td>
        <td class="top">
        </td>
        <td style="text-align:right;" class="top">
            <h2>CASH BOOK</h2>
            From <b>@Data.BLL.DateFunctions.convertToStringDate(ViewBag.From)</b> to <b>@Data.BLL.DateFunctions.convertToStringDate(ViewBag.To)</b>
        </td>
    </tr>
</table>

<table border="1" cellpadding="5" cellspacing="0" style="width:100%;">
    <thead style="background:#dddddd;">
        <tr>
            <th style="width:10%">Voucher No</th>
            <th style="width:30%">Account</th>
            <th style="width:30%">Narration</th>
            <th style="width:15%">Received</th>
            <th style="width:15%">Payment</th>
        </tr>
    </thead>
    @foreach (var view in Model.OrderBy(x => x.Date))
    {
        var Cash_Book = Ledger.CashBook(view.Date);
        {
            ownerTotal += Cash_Book.Where(x => x.AccountID == ownerAccountID).Sum(x => x.Debit) ?? 0;
            expenseTotal += Cash_Book.Where(x => x.AccountID != ownerAccountID).Sum(x => x.Debit) ?? 0;
            ownerRecevingId = Cash_Book.FirstOrDefault(x => x.AccountID == ownerAccountID)?.ID;
        }
        <tr>
            <td colspan="5">
                <h4 style="color:black;margin-top:5px;margin-bottom:5px"> <i class="la la-star"></i> @Data.BLL.DateFunctions.convertToStringDate(view.Date)</h4>
            </td>
        </tr>
        foreach (var item in Cash_Book.Where(x => x.AccountID != ownerAccountID).OrderBy(x => x.ID))
        {
            <tr>
                <td>@item.VoucherNo</td>
                <td style="font-size:12px">@item.Account.AccountTitle</td>
                <td>@item.Narration</td>
                <td class="credit" data-value="@item.Credit.GetValueOrDefault()">@((item.Credit.HasValue ? Math.Truncate(item.Credit.Value).ToString() : "0"))</td>
                <td class="debit" data-value="@item.Debit.GetValueOrDefault()">@((item.Debit.HasValue ? Math.Truncate(item.Debit.Value).ToString() : "0"))</td>
            </tr>
        }


        @*<tr style="background-color:rgb(221 221 221 / 0.41)">
                <td colspan="2"></td>
                <td style="font-weight:bold">Total</td>
                <td style="font-weight:bold">@Cash_Book.Sum(x => x.Credit) </td>
                <td style="font-weight:bold">@Cash_Book.Sum(x => x.Debit) </td>
            </tr>*@
    }

    <tr style="font-weight:bold">
        <td colspan="2"></td>
        <td style="background:rgb(12, 80, 124, 0.18)">Daily Expenses Total</td>
        <td style="background:rgb(12, 80, 124, 0.18)">0</td>
        <td style="background:rgb(12, 80, 124, 0.18)" class="">@expenseTotal.ToString("N0")</td>
    </tr>

    <tr style="font-weight:bold">
        <td colspan="2"></td>
        <td style="background:rgb(12, 80, 124, 0.18)">@ownerAccountCaption @ownerRecevingId</td>
        <td style="background:rgb(12, 80, 124, 0.18)">0</td>
        <td style="background:rgb(12, 80, 124, 0.18)" class="debit" data-value="@ownerTotal">@ownerTotal.ToString("N0")</td>
    </tr>

    <tr>
        <td></td>
        <td></td>
        <td>Tution Fee</td>
        <td class="tf">@FEE</td>
        <td>0</td>
    </tr>
    <tr>
        <td></td>
        <td></td>
        <td>Admission Fee</td>
        <td class="adm">@ADM</td>
        <td>0</td>
    </tr>
    <tr>
        <td></td>
        <td></td>
        <td>Misc Charges</td>
        <td class="misc">@MISC</td>
        <td>0</td>
    </tr>
    <tr>
        <td></td>
        <td></td>
        <td>Prev Balance</td>
        <td class="prev">@PREV</td>
        <td>0</td>
    </tr>

    <tr>
        <td></td>
        <td></td>
        <td>Fine</td>
        <td class="fine">@FINE</td>
        <td>0</td>
        <td></td>
    </tr>

    <tr style="font-weight:bold; color:black">
        <td colspan="3" class="text-right" style="padding-right:5em !important">GRAND TOTAL</td>
        <td class="total_credit"></td>
        <td class="total_debit"></td>
    </tr>

    <tr style="background-color:rgb(7, 57, 90); font-weight:bold; color:white">
        <td colspan="3" class="text-right" style="padding-right:5em !important">CLOSING BALANCE</td>
        <td colspan="2" class="closing_bal text-center"></td>
        <td></td>
    </tr>



</table>

<script>
    //////////////////////
    var sum_tf = 0;
    $(".tf").each(function () {
        sum_tf += parseFloat($(this).text());
    });

    var sum_adm = 0;
    $(".adm").each(function () {
        sum_adm += parseFloat($(this).text());
    });

    var sum_misc = 0;
    $(".misc").each(function () {
        sum_misc += parseFloat($(this).text());
    });

    var sum_prev = 0;
    $(".prev").each(function () {
        sum_prev += parseFloat($(this).text());
    });

    var sum_fine = 0;
    $(".fine").each(function () {
        sum_fine += parseFloat($(this).text());
    });

    var Total_Recv = sum_tf + sum_adm + sum_misc + sum_prev + sum_fine;
    /////////////////////



    var sum_debit = 0;
    $(".debit").each(function () {
        sum_debit += parseFloat($(this).data("value")) || 0;
    });
    $('.total_debit').text(sum_debit.toLocaleString());


    var sum_credit = 0;
    $(".credit").each(function () {
        sum_credit += parseFloat($(this).data("value")) || 0;
    });

    var MasterRcv = Total_Recv + sum_credit;
    $('.total_credit').text(MasterRcv);

    var Closing_Bal = MasterRcv - sum_debit;
    $('.closing_bal').text(Closing_Bal);

    window.onload = window.print();
</script>

<style>
    .text-right {
        text-align: right;
    }

    .text-center {
        text-align: center;
    }

    td {
        font-family: Arial;
    }
</style>