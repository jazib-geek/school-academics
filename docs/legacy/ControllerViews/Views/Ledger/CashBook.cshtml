
@{
    ViewBag.Title = "Customer";
}

<script src="~/Content/select2/select2.min.js"></script>
<link href="~/Content/select2/select2.min.css" rel="stylesheet" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.3.0/js/bootstrap-datepicker.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.3.0/css/datepicker.css" rel="stylesheet" type="text/css" />

<div class="row">
    <div class="col-md-12 card">
        <h3 class="text-center">
            <i class="la la-book text-info"></i>  CASH BOOK
        </h3>
        <div class="main">
            <div class="row py-2">
                <div class="col-md-3"></div>
                <div class="col-md-2">
                    <input type="text" id="From" class="form-control" placeholder="From Date" autocomplete="off" />
                </div>
                <div class="col-md-2">
                    <input type="text" id="To" class="form-control" placeholder="To Date" autocomplete="off" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-sm btn-info" id="btnGroup" onclick="GetLedger()">
                        <i class="la la-search"></i>
                    </button>
                    <button class="btn btn-sm btn-info hide" id="btnPrint" onclick="printReport()">
                        <i class="la la-print"></i>
                    </button>
                </div>
            </div>
            <table class="table table-bordered">
                <thead class="bg-soft-info">
                    <tr>
                        <th style="width:10%">Voucher No</th>
                        <th style="width:25%">Account</th>
                        <th style="width:40%">Narration</th>
                        <th style="width:10%">Received</th>
                        <th style="width:10%">Payment</th>
                        <th style="width:5%"></th>
                    </tr>
                </thead>
                <tbody id="table-content"></tbody>
            </table>
        </div>
    </div>
</div>



<script type="text/javascript">
    $(document).ready(function () {
        $('#AccountID').select2();
    });

    function GetLedger() {
        if ($("#From").val() != '' && $("#To").val() != '') {
            $("#loading").removeClass('hide');

            $.ajax({
                cache: false,
                type: 'Get',
                url: '/Accounts/Ledger/_CashBook',
                data: { From: $("#From").val(), To: $("#To").val() },
                datatype: 'Json',
                success: function (result) {
                    $("#loading").addClass('hide');
                    $("#table-content").removeClass('hide');
                    $("#table-content").html(result);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert('error');
                }
            });
        }
    }

    function TriggerEditModal(ID) {
        $("#modal").modal('show');
        $(".dvPartial").html('<div class="text-center"><i class="la la-3x fa-sync fa-spin" style="color:#176da5"></i></div>');
        $("#modal-title").html('EDIT ROW');
        $.ajax({
            cache: false,
            type: 'Get',
            url: '/Accounts/Voucher/_Edit',
            data: { ID: ID },
            datatype: 'Json',
            success: function (result) {
                $(".dvPartial").html('');
                $(".dvPartial").html(result);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.responseText);
            }
        });
    }

    function EditRow(ID) {
        window.location.href = '/Accounts/Ledger/EditVoucher/' + ID;
    }


    function printReport() {
        window.open('/Accounts/Ledger/PrintCashBook/?From=' + $("#From").val() + '&To=' + $("#To").val(), '_blank')
    }


    $(function () {
        $("#From").datepicker({
            autoclose: true,
            todayHighlight: true
        }).datepicker();
    });

    $(function () {
        $("#To").datepicker({
            autoclose: true,
            todayHighlight: true
        }).datepicker();
    });

     @if (Data.BLL.User.Rights.UserHasAccessToMudule("cash_book", Session["user"].ToString()) == false)
    {
        <text>  $(".main").html(''); $(".main").html('<h4 class="alert alert-danger text-center"> <i class="la la-exclamation-circle"> You do not have permission to access this feature </h4>');   </text>
     }
</script>
