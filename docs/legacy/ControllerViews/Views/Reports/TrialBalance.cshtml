
@{
    ViewBag.Title = "Customer";
}

<script src="~/Content/select2/select2.min.js"></script>
<link href="~/Content/select2/select2.min.css" rel="stylesheet" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.3.0/js/bootstrap-datepicker.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.3.0/css/datepicker.css" rel="stylesheet" type="text/css" />

<div class="row">
    <div class="col-md-12 card">
        <h3 class="text-center">
            <i class="la la-book text-info"></i>  ACCOUNT SUMMARY
        </h3>
        <div class="main">
            <div class="row py-2">
                <div class="col-md-3"></div>
                <div class="col-md-2">
                    <input type="text" id="From" class="form-control" placeholder="From Date" />
                </div>
                <div class="col-md-2">
                    <input type="text" id="To" class="form-control" placeholder="To Date" />
                </div>
                <div class="col-md-2 text-start">
                    <button class="btn btn-sm btn-primary" id="btnGroup" onclick="GetLedger()">
                        <i class="la la-search"></i>
                    </button>
                    <button class="btn btn-sm btn-info hide" id="btnPrint" onclick="printReport()">
                        <i class="la la-print"></i>
                    </button>
                </div>
            </div>
            <table class="table table-bordered">
                <thead class="bg-soft-info">
                    <tr>
                        <th style="width:20%">Account Code</th>
                        <th style="width:40%">Account</th>
                        <th style="width:10%">Received</th>
                        <th style="width:10%">Payment</th>
                        <th style="width:10%">Balance</th>
                    </tr>
                </thead>
                <tbody id="table-content"></tbody>
            </table>
        </div>
    </div>
</div>


<script type="text/javascript">
    $(document).ready(function () {
        $('#AccountID').select2();
    });

    function GetLedger() {
        if ($("#From").val() != '' && $("#To").val() != '') {
            $("#loading").removeClass('hide');

            $.ajax({
                cache: false,
                type: 'Get',
                url: '/Accounts/Reports/_TrialBalance',
                data: { From: $("#From").val(), To: $("#To").val() },
                datatype: 'Json',
                success: function (result) {
                    $("#loading").addClass('hide');
                    $("#table-content").removeClass('hide');
                    $("#table-content").html(result);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("#table-content").html(xhr.responseText);
                }
            });
        }
    }

    function printReport() {
        window.open('/Accounts/Reports/PrintTrialBalance/?From=' + $("#From").val() + '&To=' + $("#To").val(), '_blank')
    }


    $(function () {
        $("#From").datepicker({
            autoclose: true,
            todayHighlight: true
        }).datepicker();
    });

    $(function () {
        $("#To").datepicker({
            autoclose: true,
            todayHighlight: true
        }).datepicker();
    });

     @if (Data.BLL.User.Rights.UserHasAccessToMudule("cash_book", Session["user"].ToString()) == false)
    {
        <text>  $(".main").html(''); $(".main").html('<h4 class="alert alert-danger text-center"> <i class="la la-exclamation-circle"> You do not have permission to access this feature </h4>');   </text>
     }
</script>
